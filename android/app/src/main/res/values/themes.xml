<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: dark, no action bar (we use our own chrome) -->
    <style name="Theme.Reasonix" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FF6B2B</item>
        <item name="colorPrimaryDark">#1A1A2E</item>
        <item name="colorAccent">#FF6B2B</item>
        <item name="android:windowBackground">#1A1A2E</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Setup theme: centered card-style layout -->
    <style name="Theme.Reasonix.Setup" parent="Theme.Reasonix">
        <item name="android:windowBackground">#16162B</item>
    </style>
</resources>
