<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow cleartext HTTP to localhost (the Go server binds 127.0.0.1:8787) -->
    <application
        android:name=".ReasonixApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reasonix"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- Setup / first-launch screen -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Reasonix.Setup" />

        <!-- Main WebView UI -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Reasonix"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that runs the Go binary -->
        <service
            android:name=".ReasonixService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>

    <!-- Needed for foreground service notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network access for the Go server (loopback) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
